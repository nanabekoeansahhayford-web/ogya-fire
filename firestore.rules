rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all unexpected collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidListing(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.price is number && data.price >= 0
        && data.location is string && data.location.size() <= 256
        && data.currency is string && data.currency.size() <= 16
        && data.condition is string && data.condition.size() <= 64
        && data.seller is map
        && data.seller.name is string && data.seller.name.size() <= 128
        && data.seller.whatsapp is string && data.seller.whatsapp.size() <= 64;
    }

    function isValidUser(data) {
      return data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.role is string && (data.role == 'customer' || data.role == 'vendor')
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256));
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 256
        && data.price is number && data.price >= 0
        && data.stock is number && data.stock >= 0
        && data.category is string && data.category in ['Fire Extinguisher', 'Smoke Detector', 'Fire Blanket', 'Alarm', 'Hose']
        && data.vendorId is string && data.vendorId.size() <= 128
        && data.vendorName is string && data.vendorName.size() <= 256;
    }

    function isValidVendor(data) {
      return data.ownerId is string && data.ownerId.size() <= 128
        && data.shopName is string && data.shopName.size() > 0 && data.shopName.size() <= 256
        && data.phone is string && data.phone.size() <= 64
        && data.location is string && data.location.size() <= 256;
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100
        && data.total is number && data.total >= 0
        && data.deliveryAddress is string && data.deliveryAddress.size() <= 500
        && data.phone is string && data.phone.size() <= 64
        && data.status is string && data.status.size() <= 64
        && data.paymentMethod is string && data.paymentMethod.size() <= 64
        && (!('momoNumber' in data) || (data.momoNumber is string && data.momoNumber.size() <= 64));
    }

    // Health check endpoint
    match /test/connection {
      allow read: if true;
    }

    // Public marketplace listings
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isValidId(listingId) && isValidListing(request.resource.data);
      allow update: if isValidId(listingId);
      allow delete: if isValidId(listingId);
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create: if isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isValidId(userId) && (request.auth != null && request.auth.uid == userId);
    }

    // Fire safety products collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isValidProduct(request.resource.data);
      allow update: if isValidId(productId);
      allow delete: if isValidId(productId);
    }

    // Vendor shops collection
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isValidId(vendorId) && isValidVendor(request.resource.data);
      allow update: if isValidId(vendorId);
      allow delete: if isValidId(vendorId);
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow update: if isValidId(orderId);
      allow delete: if isValidId(orderId);
    }
  }
}
